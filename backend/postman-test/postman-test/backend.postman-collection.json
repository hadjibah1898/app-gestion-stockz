        {
            "name": "📁 2. Approvisionnement & Transfert (Admin)",
            "item": [
                {
                    "name": "2.1 Approvisionner le Dépôt Principal",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Code de statut est 200\", () => { pm.response.to.have.status(200); });",
                                    "pm.test(\"Le message de succès est correct\", () => {",
                                    "    pm.expect(pm.response.text()).to.include(\"Approvisionnement réussi\");",
                                    "});",
                                    "",
                                    "// On sauvegarde le nom de l'article qu'on va transférer plus tard",
                                    "const requestBody = JSON.parse(pm.request.body.raw);",
                                    "const articleNom = requestBody.items[0].nom;",
                                    "pm.collectionVariables.set(\"articleNom\", articleNom);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{adminToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"fournisseurId\": \"{{fournisseurId}}\",\n    \"items\": [\n        {\n            \"nom\": \"Article Test A {{$randomInt}}\",\n            \"quantite\": 100,\n            \"prixAchat\": 1000,\n            \"prixVente\": 1500\n        },\n        {\n            \"nom\": \"Article Test B {{$randomInt}}\",\n            \"quantite\": 50,\n            \"prixAchat\": 2000,\n            \"prixVente\": 3000\n        }\n    ]\n}",
                            "options": {
