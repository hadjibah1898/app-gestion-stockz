                {
                    "name": "3.3 Vendre un article",
                    "item": [
                        {
                            "name": "3.3.1 Lister les articles de la boutique du gérant",
                            "event": [
                                {
                                    "listen": "test",
                                    "script": {
                                        "exec": [
                                            "pm.test(\"Code de statut est 200\", () => { pm.response.to.have.status(200); });",
                                            "pm.test(\"Trouve l'article transféré et sauvegarde son ID et prix\", () => {",
                                            "    const articles = pm.response.json();",
                                            "    const articleAVendre = articles.find(a => a.nom === pm.collectionVariables.get(\"articleNom\"));",
                                            "    pm.expect(articleAVendre).to.not.be.undefined;",
                                            "    pm.collectionVariables.set(\"gerantArticleId\", articleAVendre._id);",
                                            "    pm.collectionVariables.set(\"prixVenteArticle\", articleAVendre.prixVente);",
                                            "});"
                                        ],
                                        "type": "text/javascript"
                                    }
                                }
                            ],
                            "request": {
                                "auth": {
                                    "type": "bearer",
                                    "bearer": [
                                        {
                                            "key": "token",
                                            "value": "{{gerantToken}}",
                                            "type": "string"
                                        }
                                    ]
                                },
                                "method": "GET",
                                "url": {
                                    "raw": "{{baseUrl}}/articles",
                                    "host": [
                                        "{{baseUrl}}"
                                    ],
                                    "path": [
                                        "articles"
                                    ]
                                }
                            },
                            "response": []
                        },
                        {
                            "name": "3.3.2 Enregistrer la vente",
                            "event": [
                                {
                                    "listen": "test",
                                    "script": {
                                        "exec": [
                                            "pm.test(\"Code de statut est 201\", () => { pm.response.to.have.status(201); });",
                                            "const jsonData = pm.response.json();",
                                            "// On additionne le total de cette vente au total des ventes de la session",
                                            "const totalVentesSession = (parseFloat(pm.collectionVariables.get(\"totalVentesSession\")) || 0) + jsonData.vente.prixTotal;",
                                            "pm.collectionVariables.set(\"totalVentesSession\", totalVentesSession);"
                                        ],
                                        "type": "text/javascript"
                                    }
                                }
                            ],
                            "request": {
                                "auth": {
                                    "type": "bearer",
                                    "bearer": [
                                        {
                                            "key": "token",
                                            "value": "{{gerantToken}}",
                                            "type": "string"
                                        }
                                    ]
                                },
                                "method": "POST",
                                "header": [],
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"items\": [\n        {\n            \"articleId\": \"{{gerantArticleId}}\",\n            \"quantite\": 2\n        }\n    ]\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                },
                                "url": {
                                    "raw": "{{baseUrl}}/ventes",
                                    "host": [
                                        "{{baseUrl}}"
                                    ],
                                    "path": [
                                        "ventes"
                                    ]
                                }
                            },
                            "response": []
                        }
                    ]
                },
                {
                    "name": "3.4 Créer une Dépense",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Code de statut est 201\", () => { pm.response.to.have.status(201); });",
                                    "const jsonData = pm.response.json();",
                                    "// On additionne le montant de cette dépense au total des dépenses de la session",
                                    "const totalDepensesSession = (parseFloat(pm.collectionVariables.get(\"totalDepensesSession\")) || 0) + jsonData.montant;",
                                    "pm.collectionVariables.set(\"totalDepensesSession\", totalDepensesSession);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{gerantToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"montant\": 5000,\n    \"motif\": \"Achat de sacs plastiques\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/caisse/depenses",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "caisse",
                                "depenses"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "3.5 Fermer la Caisse",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "// Calcul dynamique du montant de clôture pour un test sans écart",
                                    "const fondInitial = parseFloat(pm.collectionVariables.get(\"fondInitial\"));",
                                    "const totalVentes = parseFloat(pm.collectionVariables.get(\"totalVentesSession\"));",
                                    "const totalDepenses = parseFloat(pm.collectionVariables.get(\"totalDepensesSession\"));",
                                    "",
                                    "const montantClotureCalcule = fondInitial + totalVentes - totalDepenses;",
                                    "pm.collectionVariables.set(\"montantClotureCalcule\", montantClotureCalcule);"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Code de statut est 201\", () => { pm.response.to.have.status(201); });",
                                    "pm.test(\"L'ID du rapport est sauvegardé\", () => {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.rapport._id).to.be.a('string');",
                                    "    pm.collectionVariables.set(\"rapportId\", jsonData.rapport._id);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{gerantToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"montantCloture\": {{montantClotureCalcule}},\n    \"commentairesGérant\": \"Clôture de test automatisé.\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/caisse/fermer",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "caisse",
                                "fermer"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "3.6 Valider le Rapport (Admin)",
                    "event": [
