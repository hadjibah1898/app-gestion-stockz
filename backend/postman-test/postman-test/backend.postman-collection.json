{
    "info": {
        "name": "Tests Automatisés Backend - Gestion de Stock (FR)",
        "description": "Collection de tests Postman automatisés pour l'API du backend de l'application de gestion de stock. Les tests suivent un workflow logique, de la configuration initiale par l'admin jusqu'aux opérations du gérant et la validation par l'admin.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "📁 1. Configuration Initiale (Admin)",
            "description": "L'admin se connecte et met en place l'environnement de test : boutique, fournisseur, gérant.",
